# Скопируйте в .env и заполните. Файл .env в git не попадает.
LASTFM_KEY=
ADMIN_PIN=
# PostgreSQL: локально postgresql://localhost/flow. Для Supabase строку берёте в панели проекта
# (кнопка Connect). Это секрет, как пароль. Для самого приложения нужен pooler или direct.
DATABASE_URL=
# Только для тестов: отдельная ЛОКАЛЬНАЯ база, имя должно содержать test
DATABASE_URL_TEST=postgresql://localhost/flow_test
# Старая SQLite-база, источник для миграции
# DB_PATH=data/flow.db
